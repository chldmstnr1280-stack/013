# ─────────────────────────────────────────────────────────────
# AI Commerce Autopilot 환경 변수
# APP_MODE=mock  → 로컬 JSON 저장소 + 모의 데이터 (외부 API 호출 없음)
# APP_MODE=live  → Supabase + 실제 Claude / Threads API
# ─────────────────────────────────────────────────────────────
APP_MODE=mock

# 앱 공개 URL (OAuth 리디렉션 등에 사용)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (live 모드 필수) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude API (없으면 콘텐츠 생성이 '모의 생성'으로 표시됨) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Meta Threads API ──
THREADS_APP_ID=
THREADS_APP_SECRET=
# Meta 앱 설정에 등록한 리디렉션 URI와 정확히 같아야 함
THREADS_REDIRECT_URI=http://localhost:3000/api/threads/callback

# 액세스 토큰 암호화 키 (32바이트 hex 64자). 생성: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── 예약 실행 (Vercel Cron 또는 외부 스케줄러) ──
CRON_SECRET=

# ── 쿠팡 파트너스 Open API (승인된 경우에만) ──
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ── 발행 실패 알림 (선택: Slack/Discord 호환 webhook) ──
NOTIFY_WEBHOOK_URL=
